{
  "$schema": "../../schemas/stable/mxc-config.schema.1.0.0.json",
  "version": "1.0.0",
  "containerId": "CLI-LXC-GA-Egress-Carried-Protocol",
  "containment": "lxc",
  "process": {
    "commandLine": "{{COMMAND}}"
  },
  "lifecycle": {
    "destroyOnExit": true
  },
  "lxc": {
    "distribution": "ubuntu",
    "release": "noble"
  },
  "network": {
    "egress": {
      "default": "deny",
      "allow": [
        {
          "to": [{ "cidr": "203.0.113.0/24" }],
          "ports": [{ "protocol": "{{PROTOCOL}}", "port": {{PORT}} }]
        }
      ]
    }
  }
}
